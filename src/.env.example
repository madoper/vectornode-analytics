# VectorNode Analytics + RAG — Environment Variables
# Copy to .env and fill in real values

# PostgreSQL (analytics DB — read-only for Gateway)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=podft
POSTGRES_PASSWORD=podft-secret
ANALYTICS_DB=analytics
GATEWAY_RO_USER=gateway_ro
GATEWAY_RO_PASSWORD=gateway_ro_secret

# PostgreSQL (podft DB — for RAG documents)
PODFT_DB=podft

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=podft_fragments

# MinIO
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=podft-minio
MINIO_SECRET_KEY=podft-minio-secret

# Embedding service
EMBEDDING_URL=http://embedding:5100
EMBEDDING_MODEL=BAAI/bge-small-ru
EMBEDDING_DIM=512

# GigaChat API
GIGACHAT_CLIENT_ID=019ade09-90b2-7d5b-8ebf-aaee57d985df
GIGACHAT_SECRET=cd534c2f-c6d3-4570-b90d-44e1f2418ac6
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat:latest

# Telegram Bot
BOT_TOKEN=8902035039:AAFhttq7heF76HUW5aKnCSU2Y7mbL8aijV4

# Gateway
GATEWAY_PORT=8000
GATEWAY_URL=http://gateway:8000

# Logging
LOG_LEVEL=INFO
